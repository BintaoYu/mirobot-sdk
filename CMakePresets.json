{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Industrial Foundation Native",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/native"
    },
    {
      "name": "arm64",
      "displayName": "Industrial Foundation Linux ARM64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm64_toolchain.cmake"
      }
    },
    {
      "name": "win-mingw",
      "displayName": "Industrial Foundation Windows x64 MinGW",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/win-mingw",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw_w64_x86_64_toolchain.cmake"
      }
    },
    {
      "name": "win-msvc-cross",
      "displayName": "Industrial Foundation Windows x64 MSVC ABI Cross",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/win-msvc-cross",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/clang_cl_msvc_x64_linux_toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "arm64",
      "configurePreset": "arm64"
    },
    {
      "name": "win-mingw",
      "configurePreset": "win-mingw"
    },
    {
      "name": "win-msvc-cross",
      "configurePreset": "win-msvc-cross"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
