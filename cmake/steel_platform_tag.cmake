function(steel_sanitize_tag_component input output_var)
    string(TOLOWER "${input}" steel_tag_component)
    string(REGEX REPLACE "[^a-z0-9._-]+" "-" steel_tag_component "${steel_tag_component}")
    set(${output_var} "${steel_tag_component}" PARENT_SCOPE)
endfunction()

function(steel_compute_windows_toolchain_tag out_var)
    set(steel_toolchain_tag "")

    if (MSVC)
        set(steel_toolchain_tag "msvc")
    elseif (MINGW)
        set(steel_toolchain_tag "mingw")
    elseif (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        set(steel_toolchain_tag "mingw")
    elseif (DEFINED CMAKE_CXX_COMPILER_FRONTEND_VARIANT)
        if (CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            set(steel_toolchain_tag "msvc")
        elseif (CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
            set(steel_toolchain_tag "mingw")
        endif()
    endif()

    if (steel_toolchain_tag STREQUAL "")
        set(steel_toolchain_tag "${CMAKE_CXX_COMPILER_ID}")
        if (steel_toolchain_tag STREQUAL "")
            set(steel_toolchain_tag "${CMAKE_C_COMPILER_ID}")
        endif()
        if (steel_toolchain_tag STREQUAL "")
            set(steel_toolchain_tag "unknown")
        endif()
        steel_sanitize_tag_component("${steel_toolchain_tag}" steel_toolchain_tag)
    endif()

    set(${out_var} "${steel_toolchain_tag}" PARENT_SCOPE)
endfunction()

function(steel_compute_platform_tag out_var)
    set(steel_system_name "${CMAKE_SYSTEM_NAME}")
    if (steel_system_name STREQUAL "")
        set(steel_system_name "${CMAKE_HOST_SYSTEM_NAME}")
    endif()

    set(steel_system_processor "${CMAKE_SYSTEM_PROCESSOR}")
    if (steel_system_processor STREQUAL "")
        set(steel_system_processor "${CMAKE_HOST_SYSTEM_PROCESSOR}")
    endif()

    if (steel_system_name STREQUAL "")
        set(steel_system_name "unknown")
    endif()

    if (steel_system_processor STREQUAL "")
        set(steel_system_processor "unknown")
    endif()

    steel_sanitize_tag_component("${steel_system_name}" steel_system_name)
    steel_sanitize_tag_component("${steel_system_processor}" steel_system_processor)

    set(steel_platform_tag "${steel_system_name}-${steel_system_processor}")

    if (steel_system_name STREQUAL "windows")
        steel_compute_windows_toolchain_tag(steel_windows_toolchain_tag)
        if (NOT steel_windows_toolchain_tag STREQUAL "")
            set(steel_platform_tag "${steel_platform_tag}-${steel_windows_toolchain_tag}")
        endif()
    endif()

    set(${out_var} "${steel_platform_tag}" PARENT_SCOPE)
endfunction()
